DATABASE_URL=postgresql://postgres:postgres@postgres:5432/did_wallet

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=did_wallet

SECRET_KEY=change_me
ALGORITHM=HS256
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

MASTER_WALLET_MNEMONIC=your_24_word_mnemonic_here

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Hyperledger Besu / TrustedEntityRegistry
# From Docker backend use host.docker.internal to reach Besu on the host.
BESU_RPC_URL=http://host.docker.internal:8545
BESU_CHAIN_ID=1337
TRUSTED_ENTITY_REGISTRY_ADDRESS=0xeB35B7bA819DAD84E60752c357d45e5ce41D85c5
DID_REGISTRY_ADDRESS=0x9393486896D3ae612B4939afAF2C367Df17CC39B
CREDENTIAL_REGISTRY_ADDRESS=0x49f8866d90ffDa8B12AC5677966e963acEc6d80E
CERTIFICATE_SBT_ADDRESS=0x6468751F5D94540338058254D8F9BD1AcEa498Fe
# Demo key from Besu Developer Quickstart (rpcnode). Local/dev only.
BESU_TRUST_ADMIN_PRIVATE_KEY=0x60bbe10a196a4e71451c0f6e9ec9beab454c2a5ac0542aa5b8b733ff5719fec3
# Set false only for local backend testing without Besu.
REQUIRE_TRUSTED_ISSUER=true
REQUIRE_DID_ON_CHAIN=true
REQUIRE_CREDENTIAL_ON_CHAIN=true
CHECK_DID_ON_CHAIN_RESOLVE=true
CHECK_CREDENTIAL_ON_CHAIN_VERIFY=true
REQUIRE_CERTIFICATE_SBT=true
CHECK_CERTIFICATE_SBT_VERIFY=true
